<Window x:Class="FunctionSet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Arduino Macro Pad Configurator" 
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None"
        Background="Transparent" ResizeMode="CanResizeWithGrip">

    <Border Background="#BF1E1E1E" CornerRadius="10" BorderBrush="#444" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <TextBlock Text="ARDUINO MACRO PAD" Foreground="#AAA" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✖" Click="BtnClose_Click" Width="30" Height="25" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.Resources>
                    <Style TargetType="Button" x:Key="KeypadBtn">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="border" Background="#333" CornerRadius="8" BorderBrush="#555" BorderThickness="0,0,0,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#444"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,0"/>
                                            <Setter TargetName="border" Property="Margin" Value="0,4,0,0"/>
                                            <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="GroupBox">
                        <Setter Property="BorderBrush" Value="#444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Margin" Value="0,0,0,15"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupBox">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5,5,0,0" Padding="10,5">
                                            <ContentPresenter ContentSource="Header" TextElement.Foreground="White"/>
                                        </Border>
                                        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" Background="#20FFFFFF" Padding="10">
                                            <ContentPresenter/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="Button" x:Key="ActionBtn">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="brd" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="brd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="brd" Property="Opacity" Value="0.3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#111" CornerRadius="15" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel>
                            <ItemsControl x:Name="icTitle" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,0,3,0" 
                                   Foreground="#888" FontSize="10" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <UniformGrid Columns="3" Rows="3" Height="280">
                                <Button Content="1" Tag="1" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="2" Tag="2" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="3" Tag="3" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="4" Tag="4" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="5" Tag="5" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="6" Tag="6" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="7" Tag="7" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="8" Tag="8" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                                <Button Content="9" Tag="9" Click="BtnKey_Click" Style="{StaticResource KeypadBtn}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="#33000000" CornerRadius="5" Margin="10,20,10,0" Padding="10">
                        <TextBlock x:Name="lblStatus" Text="◉ Disconnected" Foreground="#E74C3C" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="KẾT NỐI THIẾT BỊ">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboPorts" Margin="0,0,10,0" Height="35" VerticalContentAlignment="Center" Background="White"/>
                                <Button Grid.Column="1" x:Name="btnConnect" Content="CONNECT" Width="100" Click="BtnConnect_Click" Background="#2980B9" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionBtn}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="CẤU HÌNH PHÍM">
                            <StackPanel>
                                <Border Background="#2ECC71" CornerRadius="4" Padding="5" Margin="0,0,0,15" Opacity="0.9">
                                    <TextBlock x:Name="lblCurrentMode" Text="MODE 1" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Phím:" Foreground="#BBB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtSelectedKey" Grid.Column="1" Text="None" IsReadOnly="True" Background="#333" Foreground="#2ECC71" BorderThickness="0" FontWeight="Bold" Padding="10,8" VerticalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </Grid>

                                <TextBlock Text="Chức năng gán:" Foreground="#BBB" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cboFunctions" Margin="0,0,0,15" Height="35" DisplayMemberPath="Name" SelectedValuePath="Code" Background="White" Padding="5"/>

                                <Button x:Name="btnApply" Content="LƯU CẤU HÌNH" Height="40" Click="BtnApply_Click" Background="#E67E22" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionBtn}" Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="btnCreateFunc" Content="＋ THÊM" Height="30" Margin="0,0,4,0" Click="BtnCreateFunc_Click" Background="#27AE60" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionBtn}"/>
                                    <Button Grid.Column="1" x:Name="btnEditFunc" Content="✎ SỬA" Height="30" Margin="2,0,2,0" Click="BtnEditFunc_Click" Background="#F39C12" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionBtn}"/>
                                    <Button Grid.Column="2" x:Name="btnDeleteFunc" Content="✖ XÓA" Height="30" Margin="4,0,0,0" Click="BtnDeleteFunc_Click" Background="#C0392B" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionBtn}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="btnFactoryReset" Content="⚠ RESET TO DEFAULT" Height="35" Click="BtnFactoryReset_Click" Background="#333" Foreground="#E74C3C" BorderBrush="#E74C3C" BorderThickness="1" FontWeight="Bold" Style="{StaticResource ActionBtn}" Opacity="0.8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>

</Window>