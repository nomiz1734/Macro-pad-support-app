<Window x:Class="FunctionSet.CreateMacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Chức Năng Mới" Height="420" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" 
        Background="Transparent">

    <Border Background="#BF202020" CornerRadius="10" BorderBrush="#555" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="THIẾT LẬP CHỨC NĂNG" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Tên hiển thị trên màn hình:" Foreground="#AAA" Margin="0,0,0,5" FontSize="12"/>
                <TextBox x:Name="txtName" Height="35" VerticalContentAlignment="Center" Padding="10,0" Background="#333" Foreground="White" BorderThickness="0" CaretBrush="White">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <TabControl Grid.Row="2" x:Name="MyTabControl" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,15,0" Padding="5,5">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2ECC71" />
                                            <Setter Property="Foreground" Value="#2ECC71" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#888" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="APP / FILE">
                    <Border Background="#1AFFFFFF" CornerRadius="5" Margin="0,10,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Đường dẫn file (.exe):" Foreground="#DDD" Margin="0,0,0,5"/>
                            <DockPanel>
                                <Button x:Name="btnBrowse" Content="..." Width="40" Height="30" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BtnBrowse_Click" Background="#444" Foreground="White" BorderThickness="0"/>
                                <TextBox x:Name="txtPath" Height="30" VerticalContentAlignment="Center" Background="#222" Foreground="White" BorderThickness="0" Padding="5"/>
                            </DockPanel>
                            <TextBlock Text="Ví dụ: C:\Windows\System32\calc.exe" Foreground="#666" FontStyle="Italic" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="KEYBOARD">
                    <Border Background="#1AFFFFFF" CornerRadius="5" Margin="0,10,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Phím bổ trợ (Modifiers):" Foreground="#DDD" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <CheckBox x:Name="chkCtrl" Content="Ctrl" Foreground="White" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkShift" Content="Shift" Foreground="White" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkAlt" Content="Alt" Foreground="White" Margin="0,0,20,0"/>
                            </StackPanel>

                            <TextBlock Text="Phím chính:" Margin="0,10,0,5" Foreground="#DDD" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cboKeys" Height="35" VerticalContentAlignment="Center" Background="White" Padding="5"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="DISCORD">
                    <Border Background="#1A5865F2" CornerRadius="5" Margin="0,10,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Hành động điều khiển Discord:" Foreground="#DDD" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <ComboBox x:Name="cboDiscordAction" Height="35" VerticalContentAlignment="Center" Background="White" Padding="5">
                                <ComboBoxItem Content="🔇 Mute: ON (Tắt Mic)" Tag="MUTE_ON"/>
                                <ComboBoxItem Content="🎙 Mute: OFF (Bật Mic)" Tag="MUTE_OFF"/>
                                <ComboBoxItem Content="🔄 Mute: TOGGLE (Bật/Tắt Mic)" Tag="MUTE_TOGGLE"/>
                                <Separator/>
                                <ComboBoxItem Content="🎧 Deafen: ON (Tắt Loa &amp; Mic)" Tag="DEAF_ON"/>
                                <ComboBoxItem Content="🔊 Deafen: OFF (Bật Loa &amp; Mic)" Tag="DEAF_OFF"/>
                                <ComboBoxItem Content="🔄 Deafen: TOGGLE (Bật/Tắt Loa)" Tag="DEAF_TOGGLE"/>
                            </ComboBox>

                            <Button Content="⚙ Cấu hình Client ID" Margin="0,15,0,0" Height="30" Click="BtnConfigDiscord_Click" 
                                    Background="#23272A" Foreground="#5865F2" FontWeight="Bold" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <TextBlock Text="ℹ Lưu ý: Discord cần được mở sẵn và cấp quyền kết nối khi chạy lần đầu." 
                                       Foreground="#BBB" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy Bỏ" Width="100" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click" 
                        Background="Transparent" Foreground="#AAA" FontWeight="Bold" BorderThickness="0"/>

                <Button Content="LƯU LẠI" Width="120" Height="35" Click="BtnSave_Click" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>