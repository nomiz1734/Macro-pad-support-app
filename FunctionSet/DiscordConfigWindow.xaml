<Window x:Class="FunctionSet.DiscordConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình Discord" Height="495" Width="550"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" 
        Background="Transparent">

    <Border Background="#BF23272A" CornerRadius="10" BorderBrush="#444" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙ DISCORD CONFIGURATION" Foreground="#DDD" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Click="BtnCancel_Click" Width="30" Height="25" 
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="HƯỚNG DẪN LẤY CLIENT ID" FontWeight="Bold" FontSize="14" Foreground="#5865F2" Margin="0,0,0,10"/>

                <Border Background="#2C2F33" BorderBrush="#23272A" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Bước 1: Truy cập Discord Developer Portal" Foreground="#DDD" Margin="0,0,0,5"/>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="https://discord.com/developers/applications" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="None">
                                <TextBlock Text="👉 Bấm vào đây để mở trang web" Foreground="#5865F2" FontWeight="SemiBold" TextDecorations="Underline"/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="Bước 2: Bấm 'New Application' (Góc phải) -> Đặt tên -> Create." Foreground="#BBB" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Bước 3: Copy dãy số ở dòng 'APPLICATION ID'." Foreground="#BBB" Margin="0,0,0,8"/>

                        <Border Background="#382E23" CornerRadius="4" Padding="8">
                            <TextBlock TextWrapping="Wrap" Foreground="#F1C40F" FontSize="11">
                                <Run Text="⚠ Bước 4 (Quan Trọng): Vào menu OAuth2 -> Redirects -> Add Redirect -> Nhập '"/>
                                <Hyperlink Click="CopyUrl_Click" Foreground="#F1C40F" TextDecorations="Underline" Cursor="Hand" ToolTip="Bấm để Copy">
                                    <Run Text="http://127.0.0.1"/>
                                </Hyperlink>
                                <Run Text="' -> Save Changes."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Nhập Client ID của bạn:" Foreground="White" FontWeight="SemiBold" Margin="0,20,0,8"/>

                <TextBox x:Name="txtClientId" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                         Background="#23272A" Foreground="#2ECC71" BorderBrush="#555" BorderThickness="1" 
                         FontSize="14" FontWeight="Bold" CaretBrush="White">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Ví dụ: 1215604632412979230" FontStyle="Italic" Foreground="#666" Margin="0,5,0,0" FontSize="11"/>

                <PasswordBox x:Name="txtClientSecret" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                         Background="#23272A" Foreground="#2ECC71" BorderBrush="#555" BorderThickness="1" 
                         FontSize="14" FontWeight="Bold" CaretBrush="White">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>
                <TextBlock Text="Lấy Secret tại mục OAuth2 trên web Discord." Foreground="Gray" FontStyle="Italic" FontSize="11"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                    <Button Content="TEST KẾT NỐI" Width="100" Height="35" Margin="0,0,10,0" 
        Click="BtnTest_Click" Background="#F1C40F" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Hủy" Width="80" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click" 
                            Background="Transparent" Foreground="#AAA" FontWeight="Bold" BorderThickness="0"/>

                    <Button Content="LƯU &amp; KẾT NỐI" Width="130" Height="35" Click="BtnSave_Click" 
                            Background="#5865F2" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>